#!/bin/sh -
#
# FreshPorts periodic script
#
# Purges any user password tokens more than 2 days old
#

# If there is a global system configuration file, suck it in.
#
if [ -r /etc/defaults/periodic.conf ]
then
	. /etc/defaults/periodic.conf
	source_periodic_confs
fi

# assign default values
fp_scripts_dir=${fp_scripts_dir:-%%FP_LIBEXEC%%}
fp_freshports_user=${fp_freshports_user:-%%FP_USER_FRESHPORTS%%}

case "$fp_purge_old_password_tokens_enable" in
	[Yy][Ee][Ss])
	logger -p local3.notice -t FreshPorts "into $0"
	rc=0
	echo "cd $fp_scripts_dir && %%LOCALBASE%%/bin/perl purge_old_password_tokens.pl" | su -l $fp_freshports_user || rc=3

	#
	# Tell watchgoose the purge finished.  On success only: a ping after a
	# failed run would report the check as healthy when it is not.
	#
	# This purge is what makes old password-reset tokens expire, so if it
	# stops running, unused tokens stay valid.  The watchgoose check is how
	# we hear about that.
	#
	# The URL carries a token, so it lives in /etc/periodic.conf.local as
	# fp_purge_old_password_tokens_watchgoose_url.  Empty means do not ping.
	# A failed ping is logged but does not fail the purge.
	#
	if [ $rc = 0 -a -n "$fp_purge_old_password_tokens_watchgoose_url" ]
	then
		/usr/bin/fetch --output /dev/null -q --retry --retry-delay=10 "$fp_purge_old_password_tokens_watchgoose_url" || \
			logger -p local3.warning -t FreshPorts "$0: watchgoose ping failed"
	fi
	;;

	*)  rc=0;;
esac

exit $rc
