#!/bin/sh -
#
# FreshPorts periodic script
#
# Keeps supported_releases, the FreeBSD branches supported right now,
# up to date from the FreeBSD security page and freebsd-src main.
# See https://github.com/FreshPorts/periodics/issues/2
#

# If there is a global system configuration file, suck it in.
#
if [ -r /etc/defaults/periodic.conf ]
then
	. /etc/defaults/periodic.conf
	source_periodic_confs
fi

# assign default values
fp_scripts_dir=${fp_scripts_dir:-%%FP_LIBEXEC%%}
fp_freshports_user=${fp_freshports_user:-%%FP_USER_FRESHPORTS%%}

case "$fp_supported_releases_enable" in
	[Yy][Ee][Ss])
	logger -p local3.notice -t FreshPorts "into $0"
	rc=0
	echo "cd $fp_scripts_dir && %%LOCALBASE%%/bin/perl supported_releases_update.pl" | su -l $fp_freshports_user || rc=3
	;;

	*)  rc=0;;
esac

exit $rc
